{
    "name": "rakhavirgiandi/laravel-apigator",
    "description": "Laravel package to auto-generate CRUD API (Controller, Model, Routes) from database tables",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rakha R. Virgiandi",
            "email": "rakhavirgiandi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Virgiandi\\Apigator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Virgiandi\\Apigator\\ApigatorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
